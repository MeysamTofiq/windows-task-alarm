class AppColors:
    # Default colors
    PRIMARY = "#00FFFF" #رنگ دگمه ها
    DARK_BG = "#050508"
    SIDEBAR_BG = "#080810"
    SUCCESS = "#00FF99"
    WARNING = "#FFD700"
    DANGER = "#FF0055"
    TEXT_DIM = "#526268"
    ON_PRIMARY = "#FFFFFF"
    SECONDARY = "#625B71"
    TERTIARY = "#7D5260"
    SURFACE_VARIANT = "#1A1A2E"
    ON_SURFACE_VARIANT = "#E0E0E0"
    TEXT_BRIGHT = ft.Colors.WHITE
    CARD_COLOR = "#101018"

    @classmethod
    def load_theme(cls, page):
        if not page: return
        cls.PRIMARY = page.client_storage.get('col_primary') or "#00FFFF"
        cls.DARK_BG = page.client_storage.get('col_bg') or "#050508"
        cls.SIDEBAR_BG = page.client_storage.get('col_sidebar') or "#080810"
        cls.SUCCESS = page.client_storage.get('col_success') or "#00FF99"
        cls.WARNING = page.client_storage.get('col_warning') or "#FFD700"
        cls.DANGER = page.client_storage.get('col_danger') or "#FF0055"
        cls.CARD_COLOR = page.client_storage.get('col_card') or "#101018"

    @classmethod
    def refresh_theme(cls):
        # Deprecated: Use load_theme(page) instead
        pass

class CrazySidebar(ft.Container):
    def __init__(self, page, menu_items, on_change, on_settings=None):
        super().__init__()
        self.page_ref = page
        self.menu_items_data = menu_items
        self.on_change = on_change
        self.on_settings = on_settings  # <-- اینجا
        self.width = 210
        self.bgcolor = AppColors.SIDEBAR_BG
        self.border = ft.Border(left=ft.BorderSide(1, ft.Colors.WHITE10))
        self.padding = 0
        self.item_height = 60
        self.item_spacing = 5
        self.indicator_height = 40
        self.top_offset = 115 
        
        self.active_indicator = ft.Container(
            width=4, height=self.indicator_height, bgcolor=AppColors.PRIMARY, right=5, top=self.top_offset, 
            border_radius=5,
            animate_position=ft.Animation(500, ft.AnimationCurve.EASE_OUT_BACK),
            shadow=ft.BoxShadow(blur_radius=20, color=AppColors.PRIMARY, offset=ft.Offset(-5, 0)),
        )
        self.menu_col = ft.Column(spacing=self.item_spacing)
        self.build_menu()
        self.content = ft.Stack([
            self.active_indicator,
            ft.Column([
                ft.Container(height=40),
                ft.Container(
                    content=ft.Text("منوی اصلی سیستم", color=AppColors.PRIMARY, size=13, weight=ft.FontWeight.BOLD, opacity=0.5),
                    padding=ft.Padding(0, 0, 30, 0), height=30
                ),
                ft.Container(height=15), 
                self.menu_col
            ])
        ])
      
        settings_btn = ft.Container(
                    content=ft.Row([
                        ft.Icon(ft.Icons.SETTINGS_OUTLINED, color=AppColors.TEXT_DIM, size=22),
                        ft.Text("تنظیمات", color=AppColors.TEXT_DIM, size=13),
                    ], spacing=10),
                    padding=ft.Padding(10, 0, 10, 0),
                    height=self.item_height,
                    width=190,
                    border_radius=15,
                    bgcolor=ft.Colors.TRANSPARENT,
                    on_click=lambda e: self.on_settings() if self.on_settings else None,
                    on_hover=self._on_settings_hover,
                )

        self.content = ft.Stack([
            self.active_indicator,
            ft.Column([
                ft.Container(height=40),
                ft.Container(
                    content=ft.Text(
                        "منوی اصلی سیستم",
                        color=AppColors.PRIMARY,
                        size=13,
                        weight=ft.FontWeight.BOLD,
                        opacity=0.5
                    ),
                    padding=ft.Padding(0, 0, 30, 0),
                    height=30
                ),
                ft.Container(height=15),
                self.menu_col,
                ft.Container(expand=True),  # فضای خالی برای push کردن دکمه به پایین
                ft.Divider(height=1, color=ft.Colors.WHITE10),
                settings_btn,
                ft.Container(height=10),
            ], expand=True)
        ], expand=True)

    def _on_settings_hover(self, e):
        e.control.bgcolor = (
              ft.Colors.with_opacity(0.07, AppColors.PRIMARY)
              if e.data == "true"
              else ft.Colors.TRANSPARENT
        )
        e.control.update()

    def build_menu(self):
        for i, (name, icon) in enumerate(self.menu_items_data):
            btn = ft.Container(
                content=ft.Row([
                    ft.Icon(icon, color=AppColors.TEXT_DIM, size=24),
                    ft.Text(name, color=AppColors.TEXT_DIM, size=13, weight=ft.FontWeight.NORMAL),
                ], spacing=5),
                padding=ft.Padding(10, 0, 10, 0), height=self.item_height, width=190,
                border_radius=15, on_click=lambda e, idx=i: self.select_menu(idx),
                animate=ft.Animation(300, ft.AnimationCurve.DECELERATE),
                animate_scale=ft.Animation(300, ft.AnimationCurve.DECELERATE),
                border=None, bgcolor=ft.Colors.TRANSPARENT, data=i 
            )
            self.menu_col.controls.append(btn)

    def select_menu(self, index):
        new_top = self.top_offset + (index * (self.item_height + self.item_spacing)) + (self.item_height - self.indicator_height) / 2
        self.active_indicator.top = new_top
        for i, item in enumerate(self.menu_col.controls):
            is_selected = (i == index)
            icon_control = item.content.controls[0]
            text_control = item.content.controls[1]
            icon_control.color = AppColors.PRIMARY if is_selected else AppColors.TEXT_DIM
            text_control.color = AppColors.TEXT_BRIGHT if is_selected else AppColors.TEXT_DIM
            text_control.weight = ft.FontWeight.BOLD if is_selected else ft.FontWeight.NORMAL
            if is_selected:
                item.bgcolor = ft.Colors.with_opacity(0.05, AppColors.PRIMARY)
                side = ft.BorderSide(1, AppColors.PRIMARY)
                item.border = ft.Border(top=side, bottom=side, left=side, right=side)
                item.shadow = ft.BoxShadow(blur_radius=1, color=ft.Colors.with_opacity(0.2, AppColors.PRIMARY))
                item.width = 180 
            else:
                item.bgcolor = ft.Colors.TRANSPARENT
                item.border = None
                item.shadow = None
                item.width = 190
        self.active_indicator.bgcolor = AppColors.PRIMARY
        self.active_indicator.shadow.color = AppColors.PRIMARY
        self.update()
        self.on_change(index)

